# === Obligatorio en producción (Vercel → Settings → Environment Variables) ===
# URL pública canónica. Sin esto el sitemap puede salir con localhost.
NEXT_PUBLIC_SITE_URL=https://energia-nuevo-oriente.vercel.app

# WhatsApp comercial (solo dígitos, con código de país).
NEXT_PUBLIC_WHATSAPP_NUMBER=34695866771
# Cómo se muestra el teléfono en footer y esquemas.
NEXT_PUBLIC_PHONE_DISPLAY=+34 695 866 771

# Correo y dirección visibles en footer / privacidad / JSON-LD.
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS=

# Redes (opcional). Si están vacías no se muestran.
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_FACEBOOK=

# === Medición (opcional) ===
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Solo en pruebas (Events Manager → Test events). No dejar en producción.
NEXT_PUBLIC_META_TEST_EVENT_CODE=

# === CRM HubSpot (recomendado para seguimiento de cotizaciones) ===
# Development → Keys → Service keys (no Legacy Private Apps).
# Scopes mínimos (crm.objects.notes.write NO existe; las notas usan contacts/deals write):
#   crm.objects.contacts.read
#   crm.objects.contacts.write
#   crm.objects.deals.read
#   crm.objects.deals.write
# Pipeline sugerido: Nuevo lead → Contactado → Cotización enviada → En negociación → Ganado/Perdido
# (el API crea deals en el pipeline "default", etapa appointmentscheduled).
HUBSPOT_ACCESS_TOKEN=

# === Correo de leads (Resend, opcional si ya usa HubSpot + WhatsApp) ===
RESEND_API_KEY=
LEAD_TO_EMAIL=
RESEND_FROM=

# Buzones por departamento (opcional). Si faltan, se usa LEAD_TO_EMAIL.
LEAD_EMAIL_ALQUILER=
LEAD_EMAIL_SUMINISTROS=
LEAD_EMAIL_EPP=
LEAD_EMAIL_EQUIPOS=
LEAD_EMAIL_IMPORTACION=
LEAD_EMAIL_SERVICIOS=
